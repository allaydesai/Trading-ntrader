+        instrument.nautilus_id = str(qid) if qid is not None else None
+        instrument.exchange = venue
+        self._repo.upsert(instrument)
+        logger.debug(
+            "qualification_synced",
+            ticker=ticker,
+            venue=venue,
+            nautilus_id=instrument.nautilus_id,
+        )
