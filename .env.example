# Interactive Brokers Credentials
# Get these from your IBKR account (required for IBKR data fetching)
TWS_USERNAME=your_ib_username
TWS_PASSWORD=your_ib_password
TWS_ACCOUNT=DU123456  # Your paper trading account (starts with DU for demo)

# IBKR Connection Settings
# WARNING: there are TWO trading-mode variables and which one the app reads depends on
# how you launch it. Set both to the same value and you can ignore the rest of this note.
#   - Bare metal (uv run / make web): the app reads IBKR_TRADING_MODE from this file.
#     TRADING_MODE never reaches the app at all.
#   - Docker (docker compose up): the REVERSE. Compose interpolates TRADING_MODE into the
#     app container as IBKR_TRADING_MODE (docker-compose.yml:86), and because that lands in
#     the service's environment: block it OUTRANKS this file -- the ntrader-app service has
#     no env_file: directive and the image never copies .env, so the IBKR_TRADING_MODE line
#     below is inert there. TRADING_MODE is also the ib-gateway container's own variable
#     (docker-compose.yml:50), so under Docker it is the single switch that flips BOTH the
#     gateway and the app.
# Setting them to DIFFERENT values is the trap: TRADING_MODE=live with IBKR_TRADING_MODE=paper
# gives you a live app under Docker and a paper app on bare metal, from the identical file.
TRADING_MODE=paper        # What Docker reads (ib-gateway, and the app via compose)
IBKR_TRADING_MODE=paper   # What bare metal reads (IBKRSettings.ibkr_trading_mode)
IBKR_HOST=127.0.0.1  # Use 'ib-gateway' when running in Docker
IBKR_PORT=7497       # 7497=TWS paper, 7496=TWS live, 4002=Gateway paper, 4001=Gateway live
IBKR_CLIENT_ID=1        # Historical catalog fetch. Rotates base..base+5 on connect retry.
# Client-ID reservation -- IBKR evicts the older connection when two clients share an
# ID, so the two ranges must not OVERLAP, in either direction. Not merely "differ":
#   historical      = IBKR_CLIENT_ID .. IBKR_CLIENT_ID + 5   (rotates on connect retry)
#   live + reconcile = IBKR_LIVE_CLIENT_ID .. IBKR_LIVE_CLIENT_ID + 1
# The rotation window MOVES WITH THE BASE -- 1-6 is what base 1 happens to give, not a
# fixed range. Raising IBKR_CLIENT_ID to 5 makes it 5-10 and collides with the live pair.
# With IBKR_LIVE_CLIENT_ID=10, keep IBKR_CLIENT_ID in 1-4. Both must be >= 1; client ID 0
# is IBKR's master client. Enforced at startup by IBKRSettings.validate_client_ids_distinct,
# which refuses to construct rather than letting the collision surface as a dropped session.
IBKR_LIVE_CLIENT_ID=10  # Live trading session; also reserves +1 for on-demand reconcile.

# Real-money authorization (leave unset for paper trading)
# Setting this ALONE does not enable anything -- it makes the safety gate REFUSE every
# connection, by design: the gate cannot tell "forgot the --real-money flag" from "stale
# leftover variable", so it fails closed on both. Unset it again to run paper trading.
# Real money is permitted only with the CLI --real-money flag AND an exact match against
# TWS_ACCOUNT. Both declarations, or nothing.
# Passed through to the app under Docker via docker-compose.yml (defaults to empty).
# NTRADER_REAL_MONEY_ACCOUNT=

# VNC Password for IB Gateway GUI access (Docker only)
VNC_PASSWORD=password

# Database Configuration
# Local development: Use localhost
# Docker: Connection string is overridden in docker-compose.yml
DATABASE_URL=postgresql://ntrader:ntrader@localhost:5432/ntrader_dev
DATABASE_NAME=ntrader_dev
DATABASE_USER=ntrader
DATABASE_PASSWORD=ntrader
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Application Settings
DEBUG=false
LOG_LEVEL=INFO

# Trading Settings
DEFAULT_CURRENCY=USD
DEFAULT_BALANCE=1000000
TRADE_SIZE=1000000

# Strategy Settings
FAST_EMA_PERIOD=10
SLOW_EMA_PERIOD=20

# Kraken Exchange Credentials
# Get these from https://www.kraken.com/u/security/api (required for Kraken data fetching)
KRAKEN_API_KEY=your_kraken_api_key
KRAKEN_API_SECRET=your_kraken_api_secret_base64

# Kraken Settings (optional — defaults shown)
# KRAKEN_RATE_LIMIT=10                # Max requests per second (1-20)
# KRAKEN_DEFAULT_MAKER_FEE=0.0016     # Maker fee (0-1)
# KRAKEN_DEFAULT_TAKER_FEE=0.0026     # Taker fee (0-1)

# Data Settings
MOCK_DATA_BARS=1000

# Catalog Settings (named Parquet catalogs)
CATALOG_BASE_PATH=./data/catalogs
DEFAULT_CATALOG_NAME=
NAUTILUS_PATH=./data/catalog  

# FirstRate Import Settings (optional)
FIRSTRATE_SOURCE_PATH=
FIRSTRATE_CATALOG_NAME=firstrate-etf

# FMP Metadata Provider Settings
# Get an API key from https://site.financialmodelingprep.com/ (required for ETF metadata resolution)
FMP_API_KEY=your_fmp_api_key

# FMP Settings (optional — defaults shown)
# FMP_BASE_URL=https://financialmodelingprep.com/stable   # FMP API base URL
# FMP_RATE_LIMIT=300                                       # Max requests per minute (Starter quota)
# FMP_REQUEST_TIMEOUT=30                                   # Per-request timeout in seconds
