# Interactive Brokers Credentials
# Get these from your IBKR account (required for IBKR data fetching)
TWS_USERNAME=your_ib_username
TWS_PASSWORD=your_ib_password
TWS_ACCOUNT=DU123456  # Your paper trading account (starts with DU for demo)

# IBKR Connection Settings
# NOTE: TRADING_MODE is the ib-gateway CONTAINER's variable (docker-compose.yml:50).
# The app itself reads IBKR_TRADING_MODE. Under Docker, compose maps one to the other
# (docker-compose.yml:86); on a bare-metal .env run there is NO such mapping, so set
# both or the app keeps seeing 'paper' no matter what TRADING_MODE says.
TRADING_MODE=paper        # ib-gateway container only - the app does NOT read this
IBKR_TRADING_MODE=paper   # What the app reads (IBKRSettings.ibkr_trading_mode): 'paper' or 'live'
IBKR_HOST=127.0.0.1  # Use 'ib-gateway' when running in Docker
IBKR_PORT=7497       # 7497=TWS paper, 7496=TWS live, 4002=Gateway paper, 4001=Gateway live
IBKR_CLIENT_ID=1

# Real-money authorization (leave unset for paper trading)
# Setting this ALONE does nothing except make the safety gate refuse every connection.
# It permits real money only together with the CLI --real-money flag AND an exact match
# against TWS_ACCOUNT. Unset it again to run paper trading.
# NTRADER_REAL_MONEY_ACCOUNT=

# VNC Password for IB Gateway GUI access (Docker only)
VNC_PASSWORD=password

# Database Configuration
# Local development: Use localhost
# Docker: Connection string is overridden in docker-compose.yml
DATABASE_URL=postgresql://ntrader:ntrader@localhost:5432/ntrader_dev
DATABASE_NAME=ntrader_dev
DATABASE_USER=ntrader
DATABASE_PASSWORD=ntrader
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Application Settings
DEBUG=false
LOG_LEVEL=INFO

# Trading Settings
DEFAULT_CURRENCY=USD
DEFAULT_BALANCE=1000000
TRADE_SIZE=1000000

# Strategy Settings
FAST_EMA_PERIOD=10
SLOW_EMA_PERIOD=20

# Kraken Exchange Credentials
# Get these from https://www.kraken.com/u/security/api (required for Kraken data fetching)
KRAKEN_API_KEY=your_kraken_api_key
KRAKEN_API_SECRET=your_kraken_api_secret_base64

# Kraken Settings (optional — defaults shown)
# KRAKEN_RATE_LIMIT=10                # Max requests per second (1-20)
# KRAKEN_DEFAULT_MAKER_FEE=0.0016     # Maker fee (0-1)
# KRAKEN_DEFAULT_TAKER_FEE=0.0026     # Taker fee (0-1)

# Data Settings
MOCK_DATA_BARS=1000

# Catalog Settings (named Parquet catalogs)
CATALOG_BASE_PATH=./data/catalogs
DEFAULT_CATALOG_NAME=
NAUTILUS_PATH=./data/catalog  

# FirstRate Import Settings (optional)
FIRSTRATE_SOURCE_PATH=
FIRSTRATE_CATALOG_NAME=firstrate-etf

# FMP Metadata Provider Settings
# Get an API key from https://site.financialmodelingprep.com/ (required for ETF metadata resolution)
FMP_API_KEY=your_fmp_api_key

# FMP Settings (optional — defaults shown)
# FMP_BASE_URL=https://financialmodelingprep.com/stable   # FMP API base URL
# FMP_RATE_LIMIT=300                                       # Max requests per minute (Starter quota)
# FMP_REQUEST_TIMEOUT=30                                   # Per-request timeout in seconds
